<?xml version="1.0"?>
<robot name="rosbot" xmlns:xacro="http://ros.org/wiki/xacro">
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.0612" rpy="0 0 0"/>
      <geometry>
        <box size="0.2 0.15 0.077"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0.0612" rpy="0 0 0"/>
      <geometry>
        <box size="0.2 0.15 0.077"/>
      </geometry>
    </collision>
  </link>

  <link name="laser">
    <visual>
      <origin xyz="0 0 -0.011" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.038" length="0.04"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 -0.011" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.038" length="0.04"/>
      </geometry>
    </collision>
  </link>
  <joint name="base_link_laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser"/>
    <origin xyz="0.02 0 0.131" rpy="0 0 0"/>
  </joint>

  <link name="imu"/>
  <joint name="base_link_imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu"/>
    <origin xyz="0 0 0.043" rpy="0 0 0"/>
  </joint>

  <!-- Range sensor links -->
  <link name="fl_range"/>
  <joint name="base_link_fl_range_joint" type="fixed">
    <parent link="base_link"/>
    <child link="fl_range"/>
    <origin xyz="0.1 0.05 0.053" rpy="0 0 0.13"/>
  </joint>

  <link name="fr_range"/>
  <joint name="base_link_fr_range_joint" type="fixed">
    <parent link="base_link"/>
    <child link="fr_range"/>
    <origin xyz="0.1 -0.05 0.053" rpy="0 0 -0.13"/>
  </joint>

  <link name="rl_range"/>
  <joint name="base_link_rl_range_joint" type="fixed">
    <parent link="base_link"/>
    <child link="rl_range"/>
    <origin xyz="-0.1 0.05 0.053" rpy="0 0 3.01"/>
  </joint>

  <link name="rr_range"/>
  <joint name="base_link_rr_range_joint" type="fixed">
    <parent link="base_link"/>
    <child link="rr_range"/>
    <origin xyz="-0.1 -0.05 0.053" rpy="0 0 -3.013185"/>
  </joint>

  <!-- Wheels -->
  <joint name="fl_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="front_left_wheel"/>
    <axis xyz="0 1 0"/>
    <limit effort="100" velocity="26"/>
    <origin xyz="0.05 0.11 0.043" rpy="3.141593 -0.52752 3.141593"/>
  </joint>
  <link name="front_left_wheel">
    <visual>
      <origin xyz="0 -0.0115 0" rpy="-1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.043" length="0.035"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 -0.0115 0" rpy="-1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.043" length="0.035"/>
      </geometry>
    </collision>
  </link>

  <joint name="fr_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="front_right_wheel"/>
    <axis xyz="0 1 0"/>
    <limit effort="100" velocity="26"/>
    <origin xyz="0.05 -0.11 0.043" rpy="3.141593 -1.56087 3.141593"/>
  </joint>
  <link name="front_right_wheel">
    <visual>
      <origin xyz="0 0.0115 0" rpy="-1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.043" length="0.035"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0.0115 0" rpy="-1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.043" length="0.035"/>
      </geometry>
    </collision>
  </link>

  <joint name="rl_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_left_wheel"/>
    <axis xyz="0 1 0"/>
    <limit effort="100" velocity="26"/>
    <origin xyz="-0.055 0.11 0.043" rpy="3.141593 -0.528835 3.141593"/>
  </joint>
  <link name="rear_left_wheel">
    <visual>
      <origin xyz="0 -0.0115 0" rpy="-1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.043" length="0.035"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 -0.0115 0" rpy="-1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.043" length="0.035"/>
      </geometry>
    </collision>
  </link>

  <joint name="rr_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_right_wheel"/>
    <axis xyz="0 1 0"/>
    <limit effort="100" velocity="26"/>
    <origin xyz="-0.055 -0.11 0.043" rpy="3.141593 -1.558117 3.141593"/>
  </joint>
  <link name="rear_right_wheel">
    <visual>
      <origin xyz="0 0.0115 0" rpy="-1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.043" length="0.035"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0.0115 0" rpy="-1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.043" length="0.035"/>
      </geometry>
    </collision>
  </link>

  <!-- Webots devices section -->
  <webots>
    <!-- Front range sensors mapped to left/right sensor topics for obstacle avoider -->
    <device reference="fl_range" type="DistanceSensor">
      <ros>
        <topicName>/left_sensor</topicName>
        <alwaysOn>true</alwaysOn>
      </ros>
    </device>
    <device reference="fr_range" type="DistanceSensor">
      <ros>
        <topicName>/right_sensor</topicName>
        <alwaysOn>true</alwaysOn>
      </ros>
    </device>

    <!-- Lidar -->
    <device reference="laser" type="Lidar">
      <ros>
        <topicName>/scan</topicName>
        <alwaysOn>true</alwaysOn>
        <frameName>laser</frameName>
      </ros>
    </device>

    <!-- IMU sensors -->
    <device reference="imu inertial_unit" type="InertialUnit">
      <ros>
        <topicName>/imu/data</topicName>
        <alwaysOn>true</alwaysOn>
        <frameName>imu</frameName>
      </ros>
    </device>
    <device reference="imu gyro" type="Gyro">
      <ros>
        <topicName>/gyro</topicName>
        <alwaysOn>true</alwaysOn>
      </ros>
    </device>
    <device reference="imu accelerometer" type="Accelerometer">
      <ros>
        <topicName>/accelerometer</topicName>
        <alwaysOn>true</alwaysOn>
      </ros>
    </device>

    <!-- Driver plugin -->
    <plugin type="my_package.my_robot_driver.MyRobotDriver"/>
  </webots>
</robot>